+/**
+ * BMS: энергоскан из командной строки — для дополнения «BMS Zigbee» при самом первом запуске, до Z2M.
+ *
+ * КОНТРАКТ с дополнением (не менять без дополнения):
+ *   node <пакет>/dist/adapter/ember/bms/energyScanCli.js <порт, напр. tcp://192.168.1.50:6638>
+ *   успех: в stdout ОДНА строка JSON {"results":[{"channel":11,"rssi":-85},...],"best":15}, код выхода 0;
+ *   любая ошибка: код выхода 2 и понятный текст в stderr.
+ * Журнал ядра уходит в stderr (info/debug — только при BMS_DEBUG=1), чтобы stdout оставался одной строкой JSON.
+ */
+import {setLogger} from "../../../utils/logger";
+import {Ezsp} from "../ezsp/ezsp";
+import {type EnergyScanEzsp, energyScan} from "./energyScan";
+
+export const EXIT_OK = 0;
+export const EXIT_ERROR = 2;
+
+export type EnergyScanCliIo = {
+    stdout: (line: string) => void;
+    stderr: (line: string) => void;
+    createEzsp: (portPath: string) => EnergyScanEzsp;
+};
+
+export async function runEnergyScanCli(args: readonly string[], io: EnergyScanCliIo): Promise<number> {
+    if (args.length !== 1 || !args[0]) {
+        io.stderr("Usage: node energyScanCli.js <port path, e.g. tcp://192.168.1.50:6638>");
+        return EXIT_ERROR;
+    }
+
+    try {
+        const result = await energyScan(io.createEzsp(args[0]));
+
+        io.stdout(JSON.stringify(result));
+
+        return EXIT_OK;
+    } catch (error) {
+        io.stderr(`BMS energy scan failed: ${(error as Error).message}`);
+
+        return EXIT_ERROR;
+    }
+}
+
+/* v8 ignore start */
+if (require.main === module) {
+    const toStderr = (message: string | (() => string), namespace: string): void => {
+        process.stderr.write(`[${new Date().toISOString()}] ${namespace}: ${typeof message === "function" ? message() : message}\n`);
+    };
+    const quiet = (): void => {};
+    const verbose = process.env.BMS_DEBUG === "1";
+
+    setLogger({debug: verbose ? toStderr : quiet, info: verbose ? toStderr : quiet, warning: toStderr, error: toStderr});
+
+    void runEnergyScanCli(process.argv.slice(2), {
+        stdout: (line) => process.stdout.write(`${line}\n`),
+        stderr: (line) => process.stderr.write(`${line}\n`),
+        // скорость важна только для последовательного порта (как в Z2M по умолчанию); для tcp:// не используется
+        createEzsp: (portPath) => new Ezsp({path: portPath, baudRate: 115200, rtscts: false, adapter: "ember"}),
+    })
+        .catch((error) => {
+            process.stderr.write(`BMS energy scan failed: ${error}\n`);
+            return EXIT_ERROR;
+        })
+        .then((code) => {
+            // stdout в канал (pipe) на части систем пишется асинхронно: выходим, только когда строка ушла.
+            // Выход явный: после стопа EZSP могут остаться таймеры ASH, ждать их незачем.
+            process.stdout.write("", () => process.exit(code));
+        });
+}
+/* v8 ignore stop */
