+/**
+ * BMS: энергоскан для выбора канала сети при самом первом запуске (дополнение «BMS Zigbee» зовёт его до Z2M).
+ *
+ * Шлюз Tuya создаёт сеть плагином Network Creator: меряет шум на каналах и берёт самый тихий. Z2M сам канал
+ * не выбирает (берёт из настроек), поэтому скан делаем отдельно, классами самого ember-адаптера.
+ *
+ * Сеть не создаётся и не трогается: после сброса NCP мы шлём только версию EZSP и сам скан. ezspNetworkInit
+ * не вызываем, поэтому уже существующая на координаторе сеть остаётся как была (её поднимет Z2M при старте).
+ */
+import {logger} from "../../../utils/logger";
+import {channelsToUInt32Mask} from "../../../zspec/utils";
+import {EzspNetworkScanType, EzspStatus, SLStatus} from "../enums";
+import {EZSP_MIN_PROTOCOL_VERSION, EZSP_PROTOCOL_VERSION, EZSP_STACK_TYPE_MESH} from "../ezsp/consts";
+import type {Ezsp} from "../ezsp/ezsp";
+
+const NS = "zh:ember:bms";
+
+/**
+ * Каналы-кандидаты: 15, 20 и 25 лежат между Wi-Fi каналами 1/6/11 (2,4 ГГц), 11 — на Wi-Fi канале 1,
+ * поэтому при равенстве шума он выбирается последним (см. pickBestChannel).
+ */
+export const ENERGY_SCAN_CHANNELS: readonly number[] = [11, 15, 20, 25];
+/**
+ * Показатель длительности: (2^6 + 1) периодов по 960 символов ≈ 1 с на канал. Wi-Fi шумит всплесками,
+ * короткий скан их пропускает и «тихим» может оказаться занятый канал.
+ */
+export const ENERGY_SCAN_DURATION = 6;
+/** Сколько ждём конца скана: 4 канала по ~1 с, с большим запасом на медленный TCP-мост. */
+export const ENERGY_SCAN_TIMEOUT_MSEC = 30000;
+
+export type EnergyScanChannelResult = {channel: number; rssi: number};
+export type EnergyScanResult = {results: EnergyScanChannelResult[]; best: number};
+
+/** Только то, что скан берёт у Ezsp: тест подставляет сюда поддельный. */
+export type EnergyScanEzsp = Pick<
+    Ezsp,
+    "start" | "stop" | "ezspVersion" | "setProtocolVersion" | "ezspStartScan" | "ezspEnergyScanResultHandler" | "ezspScanCompleteHandler"
+>;
+
+/**
+ * Самый тихий канал: наименьший максимум RSSI. При равенстве — меньший номер, но 11 последним
+ * (он ложится на Wi-Fi канал 1: скан мог попасть в паузу Wi-Fi, а соседство с ним постоянное).
+ */
+export function pickBestChannel(results: readonly EnergyScanChannelResult[]): number {
+    if (results.length === 0) {
+        throw new Error("No channel was measured.");
+    }
+
+    const sorted = [...results].sort((a, b) => a.rssi - b.rssi || Number(a.channel === 11) - Number(b.channel === 11) || a.channel - b.channel);
+
+    return sorted[0].channel;
+}
+
+/**
+ * Согласовать версию EZSP, как EmberAdapter.emberVersion: без неё NCP не примет ни одной другой команды.
+ */
+async function negotiateVersion(ezsp: EnergyScanEzsp): Promise<void> {
+    let [protocolVersion, stackType] = await ezsp.ezspVersion(EZSP_PROTOCOL_VERSION);
+
+    if (stackType !== EZSP_STACK_TYPE_MESH) {
+        throw new Error(`Stack type ${stackType} is not expected.`);
+    }
+
+    if (protocolVersion < EZSP_PROTOCOL_VERSION && protocolVersion >= EZSP_MIN_PROTOCOL_VERSION) {
+        [protocolVersion] = await ezsp.ezspVersion(protocolVersion);
+    } else if (protocolVersion !== EZSP_PROTOCOL_VERSION) {
+        throw new Error(
+            `Adapter EZSP protocol version (${protocolVersion}) is not supported [${EZSP_MIN_PROTOCOL_VERSION}-${EZSP_PROTOCOL_VERSION}].`,
+        );
+    }
+
+    ezsp.setProtocolVersion(protocolVersion);
+}
+
+/**
+ * Запустить EZSP, сделать ENERGY_SCAN по каналам и вернуть результат с лучшим каналом. EZSP останавливается всегда.
+ */
+export async function energyScan(
+    ezsp: EnergyScanEzsp,
+    channels: readonly number[] = ENERGY_SCAN_CHANNELS,
+    duration = ENERGY_SCAN_DURATION,
+    timeout = ENERGY_SCAN_TIMEOUT_MSEC,
+): Promise<EnergyScanResult> {
+    try {
+        const startStatus = await ezsp.start();
+
+        if (startStatus !== EzspStatus.SUCCESS) {
+            throw new Error(`Failed to start EZSP layer with status=${EzspStatus[startStatus]}.`);
+        }
+
+        await negotiateVersion(ezsp);
+
+        const maxRssi = new Map<number, number>();
+        let complete!: (error?: Error) => void;
+        const scanDone = new Promise<void>((resolve, reject) => {
+            complete = (error) => (error ? reject(error) : resolve());
+        });
+        // если старт скана упал, а NCP потом всё же пришлёт «скан окончен», отказ некому ловить — гасим здесь
+        scanDone.catch(() => {});
+
+        // Результаты EZSP отдаёт обработчиками на самом Ezsp (не событиями): подменяем их на этом экземпляре.
+        ezsp.ezspEnergyScanResultHandler = (channel: number, maxRssiValue: number): void => {
+            logger.debug(`Energy scan channel=${channel} maxRssi=${maxRssiValue} dBm.`, NS);
+
+            if (channels.includes(channel)) {
+                // по каналу может прийти несколько отчётов — берём худший (самый громкий)
+                maxRssi.set(channel, Math.max(maxRssi.get(channel) ?? maxRssiValue, maxRssiValue));
+            }
+        };
+        ezsp.ezspScanCompleteHandler = (channel: number, status: SLStatus): void => {
+            complete(status === SLStatus.OK ? undefined : new Error(`Energy scan failed on channel ${channel} with status=${SLStatus[status]}.`));
+        };
+
+        const timer = setTimeout(() => complete(new Error(`Energy scan did not complete within ${timeout}ms.`)), timeout);
+
+        try {
+            const scanStatus = await ezsp.ezspStartScan(EzspNetworkScanType.ENERGY_SCAN, channelsToUInt32Mask([...channels]), duration);
+
+            if (scanStatus !== SLStatus.OK) {
+                throw new Error(`Failed to start energy scan with status=${SLStatus[scanStatus]}.`);
+            }
+
+            await scanDone;
+        } finally {
+            clearTimeout(timer);
+        }
+
+        const results: EnergyScanChannelResult[] = [];
+
+        for (const channel of channels) {
+            const rssi = maxRssi.get(channel);
+
+            if (rssi === undefined) {
+                logger.warning(`Energy scan reported nothing for channel ${channel}, skipping it.`, NS);
+            } else {
+                results.push({channel, rssi});
+            }
+        }
+
+        return {results, best: pickBestChannel(results)};
+    } finally {
+        await ezsp.stop();
+    }
+}
