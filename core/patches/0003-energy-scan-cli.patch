+import {afterEach, beforeEach, describe, expect, it, vi} from "vitest";
+import {
+    ENERGY_SCAN_CHANNELS,
+    ENERGY_SCAN_DURATION,
+    ENERGY_SCAN_TIMEOUT_MSEC,
+    type EnergyScanEzsp,
+    energyScan,
+    pickBestChannel,
+} from "../../../src/adapter/ember/bms/energyScan";
+import {EXIT_ERROR, EXIT_OK, runEnergyScanCli} from "../../../src/adapter/ember/bms/energyScanCli";
+import {EzspNetworkScanType, EzspStatus, SLStatus} from "../../../src/adapter/ember/enums";
+import {
+    EZSP_EXTENDED_PARAMETERS_INDEX,
+    EZSP_MIN_PROTOCOL_VERSION,
+    EZSP_PROTOCOL_VERSION,
+    EZSP_STACK_TYPE_MESH,
+} from "../../../src/adapter/ember/ezsp/consts";
+import {EzspFrameID} from "../../../src/adapter/ember/ezsp/enums";
+import {Ezsp} from "../../../src/adapter/ember/ezsp/ezsp";
+import {EzspError} from "../../../src/adapter/ember/ezspError";
+
+vi.mock("../../../src/adapter/ember/uart/ash");
+
+type Report = [channel: number, maxRssi: number];
+
+/**
+ * Поддельный Ezsp: скан «идёт» после ezspStartScan — отчёты по каналам и «скан окончен» приходят через обработчики,
+ * которые energyScan подменил на этом объекте (как их вызывает настоящий Ezsp из callbackDispatch).
+ * Любое обращение к чему-то ещё (networkInit, formNetwork, смена канала...) — ошибка теста: сеть трогать нельзя.
+ */
+function makeFakeEzsp(reports: Report[], completeStatus: SLStatus = SLStatus.OK, completeChannel = 0) {
+    const fake = {
+        start: vi.fn().mockResolvedValue(EzspStatus.SUCCESS),
+        stop: vi.fn().mockResolvedValue(undefined),
+        ezspVersion: vi.fn().mockImplementation((version: number) => [version, EZSP_STACK_TYPE_MESH, 0]),
+        setProtocolVersion: vi.fn(),
+        ezspStartScan: vi.fn().mockImplementation(() => {
+            setTimeout(() => {
+                for (const [channel, rssi] of reports) {
+                    fake.ezspEnergyScanResultHandler(channel, rssi);
+                }
+
+                fake.ezspScanCompleteHandler(completeChannel, completeStatus);
+            }, 4000);
+
+            return SLStatus.OK;
+        }),
+        ezspEnergyScanResultHandler: vi.fn(),
+        ezspScanCompleteHandler: vi.fn(),
+    };
+    const allowedSet = ["ezspEnergyScanResultHandler", "ezspScanCompleteHandler"];
+    const guarded = new Proxy(fake, {
+        get(target, prop) {
+            if (!(prop in target)) {
+                throw new Error(`Unexpected Ezsp access: ${String(prop)}`);
+            }
+
+            return target[prop as keyof typeof target];
+        },
+        set(target, prop, value) {
+            if (!allowedSet.includes(String(prop))) {
+                throw new Error(`Unexpected Ezsp write: ${String(prop)}`);
+            }
+
+            target[prop as keyof typeof target] = value;
+            return true;
+        },
+    });
+
+    return {fake, ezsp: guarded as unknown as EnergyScanEzsp};
+}
+
+const QUIET_REPORTS: Report[] = [
+    [11, -70],
+    [15, -91],
+    [20, -80],
+    [25, -88],
+];
+
+describe("BMS energy scan", () => {
+    beforeEach(() => {
+        vi.useFakeTimers();
+    });
+
+    afterEach(() => {
+        vi.useRealTimers();
+    });
+
+    describe("pickBestChannel", () => {
+        it("picks the lowest energy", () => {
+            expect(
+                pickBestChannel([
+                    {channel: 11, rssi: -70},
+                    {channel: 15, rssi: -91},
+                    {channel: 20, rssi: -80},
+                    {channel: 25, rssi: -88},
+                ]),
+            ).toStrictEqual(15);
+            // 11 выбирается, если он строго тише остальных
+            expect(
+                pickBestChannel([
+                    {channel: 11, rssi: -95},
+                    {channel: 15, rssi: -91},
+                ]),
+            ).toStrictEqual(11);
+        });
+
+        it("on a tie picks the lower channel, but 11 last", () => {
+            expect(
+                pickBestChannel([
+                    {channel: 25, rssi: -90},
+                    {channel: 20, rssi: -90},
+                ]),
+            ).toStrictEqual(20);
+            expect(
+                pickBestChannel([
+                    {channel: 11, rssi: -90},
+                    {channel: 25, rssi: -90},
+                    {channel: 15, rssi: -85},
+                ]),
+            ).toStrictEqual(25);
+            expect(
+                pickBestChannel([
+                    {channel: 11, rssi: -90},
+                    {channel: 15, rssi: -90},
+                    {channel: 20, rssi: -90},
+                    {channel: 25, rssi: -90},
+                ]),
+            ).toStrictEqual(15);
+        });
+
+        it("throws when nothing measured", () => {
+            expect(() => pickBestChannel([])).toThrow("No channel was measured.");
+        });
+    });
+
+    describe("energyScan", () => {
+        it("scans candidate channels with ENERGY_SCAN and returns results and best channel", async () => {
+            const {fake, ezsp} = makeFakeEzsp(QUIET_REPORTS);
+            const p = energyScan(ezsp);
+
+            await vi.advanceTimersByTimeAsync(5000);
+            await expect(p).resolves.toStrictEqual({
+                results: [
+                    {channel: 11, rssi: -70},
+                    {channel: 15, rssi: -91},
+                    {channel: 20, rssi: -80},
+                    {channel: 25, rssi: -88},
+                ],
+                best: 15,
+            });
+
+            expect(ENERGY_SCAN_CHANNELS).toStrictEqual([11, 15, 20, 25]);
+            expect(fake.start).toHaveBeenCalledTimes(1);
+            expect(fake.ezspVersion).toHaveBeenCalledWith(EZSP_PROTOCOL_VERSION);
+            expect(fake.setProtocolVersion).toHaveBeenCalledWith(EZSP_PROTOCOL_VERSION);
+            expect(fake.ezspStartScan).toHaveBeenCalledTimes(1);
+            expect(fake.ezspStartScan).toHaveBeenCalledWith(
+                EzspNetworkScanType.ENERGY_SCAN,
+                (1 << 11) | (1 << 15) | (1 << 20) | (1 << 25),
+                ENERGY_SCAN_DURATION,
+            );
+            expect(fake.stop).toHaveBeenCalledTimes(1);
+            expect(fake.stop.mock.invocationCallOrder[0]).toBeGreaterThan(fake.ezspStartScan.mock.invocationCallOrder[0]);
+            expect(vi.getTimerCount()).toStrictEqual(0);
+        });
+
+        it("keeps the loudest of repeated reports, ignores other channels, skips unreported ones", async () => {
+            const {ezsp} = makeFakeEzsp([
+                [11, -95],
+                [15, -90],
+                [15, -60],
+                [15, -75],
+                [26, -99],
+                [25, -85],
+            ]);
+            const p = energyScan(ezsp);
+
+            await vi.advanceTimersByTimeAsync(5000);
+            await expect(p).resolves.toStrictEqual({
+                results: [
+                    {channel: 11, rssi: -95},
+                    {channel: 15, rssi: -60},
+                    {channel: 25, rssi: -85},
+                ],
+                best: 11,
+            });
+        });
+
+        it("negotiates a lower supported EZSP protocol version like the adapter", async () => {
+            const {fake, ezsp} = makeFakeEzsp(QUIET_REPORTS);
+            fake.ezspVersion.mockResolvedValueOnce([EZSP_MIN_PROTOCOL_VERSION, EZSP_STACK_TYPE_MESH, 0]);
+            const p = energyScan(ezsp);
+
+            await vi.advanceTimersByTimeAsync(5000);
+            await expect(p).resolves.toMatchObject({best: 15});
+            expect(fake.ezspVersion.mock.calls).toStrictEqual([[EZSP_PROTOCOL_VERSION], [EZSP_MIN_PROTOCOL_VERSION]]);
+            expect(fake.setProtocolVersion).toHaveBeenCalledWith(EZSP_MIN_PROTOCOL_VERSION);
+        });
+
+        it.each([
+            ["too old", EZSP_MIN_PROTOCOL_VERSION - 1, EZSP_STACK_TYPE_MESH, "is not supported"],
+            ["too new", EZSP_PROTOCOL_VERSION + 1, EZSP_STACK_TYPE_MESH, "is not supported"],
+            ["wrong stack", EZSP_PROTOCOL_VERSION, 0x01, "Stack type 1 is not expected."],
+        ])("fails on %s NCP and stops EZSP without scanning", async (_name, version, stackType, message) => {
+            const {fake, ezsp} = makeFakeEzsp(QUIET_REPORTS);
+            fake.ezspVersion.mockResolvedValueOnce([version, stackType, 0]);
+
+            await expect(energyScan(ezsp)).rejects.toThrow(message);
+            expect(fake.ezspStartScan).toHaveBeenCalledTimes(0);
+            expect(fake.stop).toHaveBeenCalledTimes(1);
+        });
+
+        it("fails when EZSP does not start", async () => {
+            const {fake, ezsp} = makeFakeEzsp(QUIET_REPORTS);
+            fake.start.mockResolvedValueOnce(EzspStatus.HOST_FATAL_ERROR);
+
+            await expect(energyScan(ezsp)).rejects.toThrow("Failed to start EZSP layer with status=HOST_FATAL_ERROR.");
+            expect(fake.ezspVersion).toHaveBeenCalledTimes(0);
+            expect(fake.stop).toHaveBeenCalledTimes(1);
+        });
+
+        it("fails when the scan does not start, without leaving a timer", async () => {
+            const {fake, ezsp} = makeFakeEzsp(QUIET_REPORTS);
+            fake.ezspStartScan.mockResolvedValueOnce(SLStatus.MAC_SCANNING);
+
+            await expect(energyScan(ezsp)).rejects.toThrow("Failed to start energy scan with status=MAC_SCANNING.");
+            expect(fake.stop).toHaveBeenCalledTimes(1);
+            expect(vi.getTimerCount()).toStrictEqual(0);
+        });
+
+        it("fails when the scan command throws, and a late completion does not leak a rejection", async () => {
+            const {fake, ezsp} = makeFakeEzsp(QUIET_REPORTS);
+            fake.ezspStartScan.mockRejectedValueOnce(new EzspError(EzspStatus.ASH_ERROR_TIMEOUTS));
+
+            await expect(energyScan(ezsp)).rejects.toThrow("ASH_ERROR_TIMEOUTS");
+            // NCP всё же сообщил «скан окончен» с ошибкой уже после отказа — не должно быть необработанного отказа
+            fake.ezspScanCompleteHandler(11, SLStatus.FAIL);
+            await vi.advanceTimersByTimeAsync(ENERGY_SCAN_TIMEOUT_MSEC);
+            expect(fake.stop).toHaveBeenCalledTimes(1);
+        });
+
+        it("fails when the NCP reports a scan error", async () => {
+            const {fake, ezsp} = makeFakeEzsp([[11, -70]], SLStatus.FAIL, 15);
+            const p = energyScan(ezsp);
+            const assertion = expect(p).rejects.toThrow("Energy scan failed on channel 15 with status=FAIL.");
+
+            await vi.advanceTimersByTimeAsync(5000);
+            await assertion;
