+    private async respondOnce(key: string, send: () => Promise<void>): Promise<void> {
+        // Дубль ждёт текущую отправку. После ошибки он имеет право отправить ответ заново.
+        while (this.#defaultResponseInflight.has(key)) {
+            await this.#defaultResponseInflight.get(key);
+        }
+
+        const now = Date.now();
+        for (const [cachedKey, expires] of this.#defaultResponseSuccess) {
+            if (expires <= now) {
+                this.#defaultResponseSuccess.delete(cachedKey);
+            }
+        }
+        if (this.#defaultResponseSuccess.has(key)) {
+            return;
+        }
+
+        const epoch = this.#defaultResponseEpoch;
+        const task = (async (): Promise<boolean> => {
+            try {
+                await send();
+                if (epoch === this.#defaultResponseEpoch) {
+                    if (this.#defaultResponseSuccess.size >= DEFAULT_RESPONSE_CACHE_LIMIT) {
+                        const oldestKey = this.#defaultResponseSuccess.keys().next().value;
+                        if (oldestKey !== undefined) {
+                            this.#defaultResponseSuccess.delete(oldestKey);
+                        }
+                    }
+                    this.#defaultResponseSuccess.set(key, Date.now() + DEFAULT_RESPONSE_DEDUP_MSEC);
+                }
+                return true;
             } catch (error) {
                 logger.debug(`Default response to ${this.ieeeAddr} failed (${error})`, NS);
-            }
+                return false;
+            }
+        })();
+        // При потоке разных запросов память ограничена; переполнение не запрещает отвечать.
+        const tracked = this.#defaultResponseInflight.size < DEFAULT_RESPONSE_CACHE_LIMIT;
+        if (tracked) {
+            this.#defaultResponseInflight.set(key, task);
+        }
+        await task;
+        if (tracked) {
+            this.#defaultResponseInflight.delete(key);
         }
     }
 
