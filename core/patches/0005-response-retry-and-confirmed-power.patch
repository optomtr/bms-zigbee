+    describe("BMS: default response retry and bounded deduplication", () => {
+        const responseFrame = (cluster = "genOnOff", value = 1, tsn = 29) =>
+            Zcl.Frame.create(
+                Zcl.FrameType.GLOBAL,
+                Zcl.Direction.SERVER_TO_CLIENT,
