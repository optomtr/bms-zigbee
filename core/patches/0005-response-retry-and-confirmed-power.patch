+            );
+
+        const setupResponse = async () => {
+            await controller.start();
+            await mockAdapterEvents.deviceJoined({networkAddress: 129, ieeeAddr: "0x129"});
+            const device = controller.getDeviceByIeeeAddr("0x129")!;
+            const endpoint = device.getEndpoint(1)!;
+            const send = vi.spyOn(endpoint, "defaultResponse").mockResolvedValue(undefined);
+            const receive = (frame = responseFrame(), target = endpoint) =>
+                device.onZclData(
+                    {
+                        wasBroadcast: false,
+                        address: 129,
+                        clusterID: frame.cluster.ID,
+                        data: frame.toBuffer(),
+                        header: frame.header,
+                        endpoint: target.ID,
+                        linkquality: 19,
+                        groupID: 0,
+                    },
+                    frame,
+                    target,
+                    undefined,
+                );
+            return {device, endpoint, send, receive};
+        };
+
+        it("retries the same request after send failure, then suppresses its immediate duplicate", async () => {
+            const {send, receive} = await setupResponse();
+            send.mockRejectedValueOnce(new Error("radio busy"));
+            await receive();
+            await receive();
+            await receive();
+            expect(send).toHaveBeenCalledTimes(2);
+        });
+
+        it("shares a successful in-flight response between concurrent duplicates", async () => {
+            const {send, receive} = await setupResponse();
+            let resolve!: () => void;
+            send.mockImplementationOnce(
+                () =>
+                    new Promise<void>((done) => {
+                        resolve = done;
+                    }),
+            );
+            const first = receive();
+            const duplicate = receive();
+            expect(send).toHaveBeenCalledTimes(1);
+            resolve();
+            await Promise.all([first, duplicate]);
+            expect(send).toHaveBeenCalledTimes(1);
+        });
+
+        it("a waiting duplicate retries an unsuccessful in-flight response", async () => {
+            const {send, receive} = await setupResponse();
+            let reject!: (error: Error) => void;
+            send.mockImplementationOnce(
+                () =>
+                    new Promise<void>((_done, fail) => {
+                        reject = fail;
+                    }),
+            );
+            const first = receive();
+            const duplicates = [receive(), receive()];
+            reject(new Error("delivery failed"));
+            await Promise.all([first, ...duplicates]);
+            expect(send).toHaveBeenCalledTimes(2);
+        });
+
+        it("does not confuse the same TSN across endpoints, clusters or payloads", async () => {
+            const {device, send, receive} = await setupResponse();
+            const second = await device.createEndpoint(2);
+            const secondSend = vi.spyOn(second, "defaultResponse").mockResolvedValue(undefined);
+            await receive();
+            await receive(responseFrame(), second);
+            await receive(responseFrame("genLevelCtrl"));
+            await receive(responseFrame("genOnOff", 0));
+            expect(send).toHaveBeenCalledTimes(3);
+            expect(secondSend).toHaveBeenCalledTimes(1);
+        });
+
+        it("responds again after the retry window or transient device reset", async () => {
+            const {device, send, receive} = await setupResponse();
+            await receive();
+            vi.setSystemTime(Date.now() + 1000);
+            await receive();
+            device.resetTransient(false);
+            await receive();
+            expect(send).toHaveBeenCalledTimes(3);
+        });
+
+        it("evicts old completed responses instead of keeping unbounded history", async () => {
+            const {send, receive} = await setupResponse();
