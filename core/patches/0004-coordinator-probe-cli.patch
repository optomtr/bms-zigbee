@@ -0,0 +1,150 @@
+/**
+ * BMS: поиск и проверка координатора из командной строки — для дополнения «BMS Zigbee» (до запуска Z2M).
+ *
+ * КОНТРАКТ с дополнением (не менять без дополнения):
+ *   node <пакет>/dist/adapter/ember/bms/coordinatorCli.js probe tcp://<ip>:<порт>
+ *     stdout — ОДНА строка: {"ok":true,"path":"tcp://…","ezspProtocol":13,"stackVersion":"7.4.4.0","eui64":"0x…"}, код 0;
+ *     по адресу не EZSP-координатор (порт закрыт / не EZSP / таймаут): {"ok":false,"path":"…","error":"…"}, код 3.
+ *   node <пакет>/dist/adapter/ember/bms/coordinatorCli.js discover <cidr> [<cidr> …] [--port 6638] [--eui64 0x…]
+ *     stdout — ОДНА строка: {"found":[{"path":"tcp://…","ezspProtocol":13,"stackVersion":"…","eui64":"…"}, …]};
+ *     код 0 — найден хоть один, 3 — никого.
+ *   Неверные аргументы / внутренняя ошибка: код 2, текст в stderr, stdout пуст.
+ * Журнал ядра и заметки поиска уходят в stderr (info/debug — только при BMS_DEBUG=1).
+ */
+import {
+    DEFAULT_COORDINATOR_PORT,
+    discoverCoordinators,
+    type Ipv4Network,
+    isTcpCoordinatorPath,
+    isTcpPortOpen,
+    type PortCheck,
+    type ProbeEzsp,
+    parseCidr,
+    probeCoordinator,
+} from "./coordinatorProbe";
+import {type CliOutput, createCliEzsp, runCliMain} from "./ezspSession";
+
+export const EXIT_OK = 0;
+export const EXIT_ERROR = 2;
+export const EXIT_NOT_FOUND = 3;
+
+export const USAGE = [
+    "Usage:",
+    "  node coordinatorCli.js probe tcp://<ip>:<port>",
+    `  node coordinatorCli.js discover <cidr> [<cidr> ...] [--port ${DEFAULT_COORDINATOR_PORT}] [--eui64 0x<16 hex digits>]`,
+].join("\n");
+
+export type CoordinatorCliIo = CliOutput & {
+    createEzsp: (path: string) => ProbeEzsp;
+    checkPort: PortCheck;
+};
+
+type DiscoverArgs = {networks: Ipv4Network[]; port: number; eui64?: string};
+
+/** Разбор аргументов discover. Строка — текст ошибки для stderr. */
+export function parseDiscoverArgs(args: readonly string[]): DiscoverArgs | string {
+    const networks: Ipv4Network[] = [];
+    let port = DEFAULT_COORDINATOR_PORT;
+    let eui64: string | undefined;
+
+    for (let i = 0; i < args.length; i++) {
+        const arg = args[i];
+
+        if (arg === "--port") {
+            const value = args[++i];
+
+            if (value === undefined || !/^\d{1,5}$/.test(value) || Number(value) < 1 || Number(value) > 65535) {
+                return `Invalid --port: ${value ?? "(missing)"}`;
+            }
+
+            port = Number(value);
+        } else if (arg === "--eui64") {
+            const value = args[++i];
+
+            if (value === undefined || !/^0x[0-9a-f]{16}$/i.test(value)) {
+                return `Invalid --eui64: ${value ?? "(missing)"} (expected 0x and 16 hex digits)`;
+            }
+
+            // ядро отдаёт EUI64 в нижнем регистре — сравниваем так же
+            eui64 = value.toLowerCase();
+        } else {
+            const network = parseCidr(arg);
+
+            if (network === undefined) {
+                return `Invalid network: ${arg} (expected IPv4 CIDR, e.g. 192.168.1.0/24)`;
+            }
+
+            networks.push(network);
+        }
+    }
+
+    if (networks.length === 0) {
+        return "No network given.";
+    }
+
+    return {networks, port, eui64};
+}
+
+async function runProbe(args: readonly string[], io: CoordinatorCliIo): Promise<number> {
+    if (args.length !== 1 || !isTcpCoordinatorPath(args[0])) {
+        io.stderr(`Invalid probe arguments: ${JSON.stringify(args)}\n${USAGE}`);
+        return EXIT_ERROR;
+    }
+
+    const result = await probeCoordinator(io.createEzsp(args[0]), args[0]);
+
+    io.stdout(JSON.stringify(result));
+
+    return result.ok ? EXIT_OK : EXIT_NOT_FOUND;
+}
+
+async function runDiscover(args: readonly string[], io: CoordinatorCliIo): Promise<number> {
+    const parsed = parseDiscoverArgs(args);
+
+    if (typeof parsed === "string") {
+        io.stderr(`${parsed}\n${USAGE}`);
+        return EXIT_ERROR;
+    }
+
+    const found = await discoverCoordinators({
+        ...parsed,
+        checkPort: io.checkPort,
+        probe: (path) => probeCoordinator(io.createEzsp(path), path),
+        log: io.stderr,
+    });
+
+    io.stdout(JSON.stringify({found}));
+
+    return found.length > 0 ? EXIT_OK : EXIT_NOT_FOUND;
+}
+
+export async function runCoordinatorCli(args: readonly string[], io: CoordinatorCliIo): Promise<number> {
+    try {
+        switch (args[0]) {
+            case "probe":
+                return await runProbe(args.slice(1), io);
+            case "discover":
+                return await runDiscover(args.slice(1), io);
+            default:
+                io.stderr(USAGE);
+                return EXIT_ERROR;
+        }
+    } catch (error) {
+        // сюда попадает только неожиданное (probe сам ошибок не бросает) — по контракту это код 2 и пустой stdout
+        io.stderr(`BMS coordinator ${args[0]} failed: ${(error as Error).message}`);
+
+        return EXIT_ERROR;
+    }
+}
+
+/* v8 ignore start */
+if (require.main === module) {
+    runCliMain("BMS coordinator CLI failed", (output) =>
+        runCoordinatorCli(process.argv.slice(2), {
+            ...output,
+            createEzsp: createCliEzsp,
+            checkPort: (host, port) => isTcpPortOpen(host, port),
+        }),
+    );
+}
+/* v8 ignore stop */
