@@ -0,0 +1,241 @@
+/**
+ * BMS: найти координатор (SLZB-06M и подобные: EmberZNet по EZSP поверх TCP) в локальной сети и узнать его прошивку.
+ *
+ * Зачем: владелец ставит дополнение «BMS Zigbee» и втыкает координатор в сеть — IP он вводить не должен.
+ * Дополнение перебирает адреса своих сетей (discover), а найденный адрес проверяет (probe) — до запуска Z2M.
+ *
+ * Координатор не меняется: probe делает только то, с чего начинает сам ember-адаптер — сброс NCP по ASH, VERSION,
+ * чтение версии стека (GET_VALUE VERSION_INFO) и EUI64. Сеть не создаётся и не трогается; EZSP закрывается всегда.
+ */
+import {Socket} from "node:net";
+import {logger} from "../../../utils/logger";
+import type {Eui64} from "../../../zspec/tstypes";
+import {SLStatus} from "../enums";
+import type {Ezsp} from "../ezsp/ezsp";
+import {type EzspSessionEzsp, type NcpVersion, withEzspSession} from "./ezspSession";
+
+const NS = "zh:ember:bms";
+
+/** Порт EZSP-по-TCP у SMLIGHT SLZB-06M (и у Z2M в примерах) по умолчанию. */
+export const DEFAULT_COORDINATOR_PORT = 6638;
+/**
+ * Сколько ждём весь probe. Сброс ASH на живом NCP занимает ~1 с, upstream ждёт RSTACK до 5 с на попытку:
+ * 15 с — это две полные попытки и сами команды. Дольше ждать незачем: так отвечает не координатор.
+ */
+export const PROBE_TIMEOUT_MSEC = 15000;
+/** TCP-подключение в своей сети отвечает за миллисекунды; 400 мс — запас на Wi-Fi, при этом /24 обходится за ~2 с. */
+export const CONNECT_TIMEOUT_MSEC = 400;
+/** Сколько адресов проверяем одновременно: столько сокетов не упрётся в лимиты ОС и не забьёт домашний роутер. */
+export const CONNECT_CONCURRENCY = 64;
+/** Больше /22 не перебираем: это уже не домашняя сеть, а перебор займёт минуты и похож на сканирование. */
+export const MAX_NETWORK_ADDRESSES = 1024;
+
+export type CoordinatorInfo = {
+    ezspProtocol: number;
+    stackVersion: string;
+    /** null — прошивка со слишком старым (или новым) протоколом: дальше VERSION с ней не говорим */
+    eui64: Eui64 | null;
+};
+
+export type ProbeResult = ({ok: true; path: string} & CoordinatorInfo) | {ok: false; path: string; error: string};
+
+/** Только то, что probe берёт у Ezsp: тест подставляет сюда поддельный (любое другое обращение — ошибка теста). */
+export type ProbeEzsp = EzspSessionEzsp & Pick<Ezsp, "ezspGetVersionStruct" | "ezspGetEui64">;
+
+/** Версия стека из ответа VERSION: 0x7440 -> "7.4.4.0" (по полубайту на major.minor.patch.special). */
+export function formatStackVersion(stackVersion: number): string {
+    return [12, 8, 4, 0].map((shift) => (stackVersion >> shift) & 0x0f).join(".");
+}
+
+async function readCoordinatorInfo(ezsp: ProbeEzsp, version: NcpVersion): Promise<CoordinatorInfo> {
+    if (!version.supported) {
+        // С таким протоколом хост дальше VERSION не умеет (Z2M с ним тоже не заработает) — не шлём ничего лишнего;
+        // версию стека берём из ответа VERSION: дополнению этого хватит, чтобы сказать «обновите прошивку».
+        return {ezspProtocol: version.protocolVersion, stackVersion: formatStackVersion(version.stackVersion), eui64: null};
+    }
+
+    // как EmberAdapter.emberVersion: полная версия — из VERSION_INFO (в ответе VERSION на каждое число лишь полубайт)
+    const [status, versionStruct] = await ezsp.ezspGetVersionStruct();
+    const stackVersion =
+        status === SLStatus.OK
+            ? `${versionStruct.major}.${versionStruct.minor}.${versionStruct.patch}.${versionStruct.special}`
+            : formatStackVersion(version.stackVersion);
+    // как EmberAdapter.initEzsp: EUI64 координатора — тот же, что Z2M покажет как адрес координатора
+    const eui64 = await ezsp.ezspGetEui64();
+
+    return {ezspProtocol: version.protocolVersion, stackVersion, eui64};
+}
+
+/**
+ * Проверить, отвечает ли по адресу EZSP-координатор, и прочитать его версию и EUI64. Не бросает: ошибка -> ok:false.
+ */
+export async function probeCoordinator(ezsp: ProbeEzsp, path: string, timeout = PROBE_TIMEOUT_MSEC): Promise<ProbeResult> {
+    try {
+        const info = await withEzspSession(ezsp, (version) => readCoordinatorInfo(ezsp, version), timeout);
+
+        return {ok: true, path, ...info};
+    } catch (error) {
+        return {ok: false, path, error: (error as Error).message};
+    }
+}
+
+/** Адрес вида tcp://<хост>:<порт> — другой путь probe не принимает (контракт с дополнением). */
+export function isTcpCoordinatorPath(path: string): boolean {
+    try {
+        const url = new URL(path);
+        const port = Number(url.port);
+
+        return (
+            url.protocol === "tcp:" &&
+            url.hostname !== "" &&
+            port >= 1 &&
+            (url.pathname === "" || url.pathname === "/") &&
+            url.search === "" &&
+            url.hash === "" &&
+            url.username === ""
+        );
+    } catch {
+        return false;
+    }
+}
+
+export type Ipv4Network = {cidr: string; network: number; prefix: number; size: number};
+
+function parseIpv4(text: string): number | undefined {
+    const parts = text.split(".");
+
+    if (parts.length !== 4 || !parts.every((part) => /^\d{1,3}$/.test(part) && Number(part) <= 255)) {
+        return undefined;
+    }
+
+    // >>> 0 — чтобы адрес оставался беззнаковым 32-битным числом (сдвиг в JS знаковый)
+    return parts.reduce((acc, part) => ((acc << 8) | Number(part)) >>> 0, 0);
+}
+
+export function formatIpv4(address: number): string {
+    return [24, 16, 8, 0].map((shift) => (address >>> shift) & 0xff).join(".");
+}
+
+/**
+ * Разобрать IPv4 CIDR. Адрес может быть адресом интерфейса (192.168.1.37/24, так его отдаёт Home Assistant) —
+ * берём сеть. undefined — не CIDR.
+ */
+export function parseCidr(cidr: string): Ipv4Network | undefined {
+    const match = /^([\d.]+)\/(\d{1,2})$/.exec(cidr);
+
+    if (!match) {
+        return undefined;
+    }
+
+    const address = parseIpv4(match[1]);
+    const prefix = Number(match[2]);
+
+    if (address === undefined || prefix > 32) {
+        return undefined;
+    }
+
+    const mask = prefix === 0 ? 0 : (0xffffffff << (32 - prefix)) >>> 0;
+
+    return {cidr, network: (address & mask) >>> 0, prefix, size: 2 ** (32 - prefix)};
+}
+
+/** Адреса узлов сети: без адреса сети и широковещательного; в /31 и /32 их нет (RFC 3021) — берём все. */
+export function networkHosts(network: Ipv4Network): string[] {
+    const hosts: string[] = [];
+    const [first, last] = network.prefix >= 31 ? [0, network.size - 1] : [1, network.size - 2];
+
+    for (let i = first; i <= last; i++) {
+        hosts.push(formatIpv4(network.network + i));
+    }
+
+    return hosts;
+}
+
+/** Открыт ли TCP-порт. Подключились — сразу закрываем: этим подключением ничего не шлём, NCP его не заметит. */
+export function isTcpPortOpen(host: string, port: number, timeout = CONNECT_TIMEOUT_MSEC, createSocket = () => new Socket()): Promise<boolean> {
+    return new Promise((resolve) => {
+        const socket = createSocket();
+        let timer: NodeJS.Timeout | undefined;
+        const finish = (open: boolean): void => {
+            clearTimeout(timer);
+            socket.removeAllListeners();
+            // ошибка после destroy (ECONNRESET и т.п.) уже не важна, но без слушателя она уронила бы процесс
+            socket.on("error", () => {});
+            socket.destroy();
+            resolve(open);
+        };
+
+        timer = setTimeout(() => finish(false), timeout);
+        socket.once("connect", () => finish(true));
+        socket.once("error", () => finish(false));
+        socket.connect(port, host);
+    });
+}
+
+export type PortCheck = (host: string, port: number) => Promise<boolean>;
+
+/** Хосты с открытым портом, в порядке исходного списка (подключения идут параллельно, до `concurrency` сразу). */
+export async function findOpenPorts(hosts: readonly string[], port: number, check: PortCheck, concurrency = CONNECT_CONCURRENCY): Promise<string[]> {
+    const open = new Array<boolean>(hosts.length).fill(false);
+    let next = 0;
+    const worker = async (): Promise<void> => {
+        while (next < hosts.length) {
+            const i = next++;
+            open[i] = await check(hosts[i], port);
+        }
+    };
+
+    await Promise.all(Array.from({length: Math.min(concurrency, hosts.length)}, worker));
+
+    return hosts.filter((_host, i) => open[i]);
+}
+
+export type DiscoverOptions = {
+    networks: readonly Ipv4Network[];
+    port: number;
+    /** только координатор с этим EUI64 (нижний регистр, 0x + 16 цифр) */
+    eui64?: string;
+    checkPort: PortCheck;
+    probe: (path: string) => Promise<ProbeResult>;
+    log: (line: string) => void;
+};
+
+export type DiscoveredCoordinator = {path: string} & CoordinatorInfo;
+
+/**
+ * Перебрать сети: открытые порты ищем параллельно, а probe по ним — по очереди (каждый probe сбрасывает NCP,
+ * и одному координатору незачем получать сразу несколько сбросов).
+ */
+export async function discoverCoordinators(options: DiscoverOptions): Promise<DiscoveredCoordinator[]> {
+    const hosts = new Set<string>();
+
+    for (const network of options.networks) {
+        if (network.size > MAX_NETWORK_ADDRESSES) {
+            options.log(`Skipping network ${network.cidr}: ${network.size} addresses, more than ${MAX_NETWORK_ADDRESSES}.`);
+            continue;
+        }
+
+        for (const host of networkHosts(network)) {
+            hosts.add(host);
+        }
+    }
+
+    const openHosts = await findOpenPorts([...hosts], options.port, options.checkPort);
+    const found: DiscoveredCoordinator[] = [];
+
+    logger.debug(`Discover: ${hosts.size} addresses, port ${options.port} open on [${openHosts.join(", ")}].`, NS);
+
+    for (const host of openHosts) {
+        const result = await options.probe(`tcp://${host}:${options.port}`);
+
+        if (!result.ok) {
+            options.log(`${result.path}: no EZSP coordinator (${result.error})`);
+        } else if (options.eui64 !== undefined && result.eui64 !== options.eui64) {
+            options.log(`${result.path}: EUI64 ${result.eui64} does not match ${options.eui64}, skipping.`);
+        } else {
+            found.push({path: result.path, ezspProtocol: result.ezspProtocol, stackVersion: result.stackVersion, eui64: result.eui64});
+        }
+    }
+
+    return found;
+}
