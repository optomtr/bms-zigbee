diff --git a/src/adapter/ember/bms/ezspSession.ts b/src/adapter/ember/bms/ezspSession.ts
new file mode 100644
index 0000000..45d7ab0
--- /dev/null
+++ b/src/adapter/ember/bms/ezspSession.ts
@@ -0,0 +1,125 @@
+/**
+ * BMS: общее для наших CLI (энергоскан, поиск координатора) — открыть EZSP так же, как ember-адаптер, и всегда закрыть.
+ *
+ * Почему отдельный модуль: оба CLI подключаются к координатору ДО Z2M и должны делать первые шаги ровно как
+ * EmberAdapter.initEzsp/emberVersion (сброс NCP по ASH, затем VERSION) и всегда отпускать порт — иначе следом
+ * не подключится Z2M. Одна реализация на оба, чтобы они не разошлись.
+ */
+import {setLogger} from "../../../utils/logger";
+import {EzspStatus} from "../enums";
+import {EZSP_MIN_PROTOCOL_VERSION, EZSP_PROTOCOL_VERSION, EZSP_STACK_TYPE_MESH} from "../ezsp/consts";
+import {Ezsp} from "../ezsp/ezsp";
+
+/** Только то, что сеанс берёт у Ezsp: тесты подставляют сюда поддельный. */
+export type EzspSessionEzsp = Pick<Ezsp, "start" | "stop" | "ezspVersion" | "setProtocolVersion">;
+
+export type NcpVersion = {
+    /** версия протокола EZSP, на которой работает NCP */
+    protocolVersion: number;
+    /** версия стека из ответа VERSION: 4 полубайта major.minor.patch.special */
+    stackVersion: number;
+    /** хост (этот ember-адаптер) умеет говорить с NCP дальше VERSION */
+    supported: boolean;
+};
+
+/**
+ * Запустить EZSP (сброс NCP по ASH) и согласовать версию — как EmberAdapter.initEzsp + emberVersion.
+ * На неподдерживаемом протоколе не бросает: решает вызывающий (энергоскан — ошибка, поиск — «прошивка старая»).
+ * Версия хоста выставляется только для поддерживаемого протокола: с другим NCP мы дальше VERSION не говорим.
+ */
+export async function startEzspSession(ezsp: EzspSessionEzsp): Promise<NcpVersion> {
+    const startStatus = await ezsp.start();
+
+    if (startStatus !== EzspStatus.SUCCESS) {
+        throw new Error(`Failed to start EZSP layer with status=${EzspStatus[startStatus]}.`);
+    }
+
+    let [protocolVersion, stackType, stackVersion] = await ezsp.ezspVersion(EZSP_PROTOCOL_VERSION);
+
+    if (stackType !== EZSP_STACK_TYPE_MESH) {
+        throw new Error(`Stack type ${stackType} is not expected.`);
+    }
+
+    if (protocolVersion < EZSP_PROTOCOL_VERSION && protocolVersion >= EZSP_MIN_PROTOCOL_VERSION) {
+        [protocolVersion, , stackVersion] = await ezsp.ezspVersion(protocolVersion);
+    }
+
+    const supported = protocolVersion >= EZSP_MIN_PROTOCOL_VERSION && protocolVersion <= EZSP_PROTOCOL_VERSION;
+
+    if (supported) {
+        ezsp.setProtocolVersion(protocolVersion);
+    }
+
+    return {protocolVersion, stackVersion, supported};
+}
+
+export function unsupportedProtocolMessage(protocolVersion: number): string {
+    return `Adapter EZSP protocol version (${protocolVersion}) is not supported [${EZSP_MIN_PROTOCOL_VERSION}-${EZSP_PROTOCOL_VERSION}].`;
+}
+
+/**
+ * Открыть сеанс EZSP, выполнить работу и закрыть EZSP ВСЕГДА — и при ошибке, и по таймауту (порт освобождается для Z2M).
+ * Таймаут нужен поиску: TCP-подключение к адресу, где пакеты молча теряются, само не кончается, а сброс ASH
+ * на чужом (не EZSP) порту ждёт RSTACK до 5 попыток по 5 с.
+ */
+export async function withEzspSession<T>(ezsp: EzspSessionEzsp, work: (version: NcpVersion) => Promise<T>, timeout?: number): Promise<T> {
+    let timer: NodeJS.Timeout | undefined;
+
+    try {
+        const session = startEzspSession(ezsp).then(work);
+
+        if (timeout === undefined) {
+            return await session;
+        }
+
+        // поздний отказ брошенного по таймауту сеанса не всплывёт как Unhandled Rejection: race уже подписан на него
+        const expired = new Promise<never>((_resolve, reject) => {
+            timer = setTimeout(() => reject(new Error(`No EZSP answer within ${timeout}ms.`)), timeout);
+        });
+
+        return await Promise.race([session, expired]);
+    } finally {
+        clearTimeout(timer);
+        await ezsp.stop();
+    }
+}
+
+/** Ezsp для CLI. Скорость важна только для последовательного порта (как в Z2M по умолчанию); для tcp:// не используется. */
+export function createCliEzsp(portPath: string): Ezsp {
+    return new Ezsp({path: portPath, baudRate: 115200, rtscts: false, adapter: "ember"});
+}
+
+export type CliOutput = {
+    stdout: (line: string) => void;
+    stderr: (line: string) => void;
+};
+
+/* v8 ignore start */
+/**
+ * Обвязка процесса для наших CLI: журнал ядра — в stderr (info/debug — только при BMS_DEBUG=1), чтобы stdout оставался
+ * одной строкой JSON по контракту с дополнением; неожиданная ошибка — код 2 (у обоих CLI это «ошибка»).
+ */
+export function runCliMain(errorPrefix: string, run: (output: CliOutput) => Promise<number>): void {
+    const toStderr = (message: string | (() => string), namespace: string): void => {
+        process.stderr.write(`[${new Date().toISOString()}] ${namespace}: ${typeof message === "function" ? message() : message}\n`);
+    };
+    const quiet = (): void => {};
+    const verbose = process.env.BMS_DEBUG === "1";
+
+    setLogger({debug: verbose ? toStderr : quiet, info: verbose ? toStderr : quiet, warning: toStderr, error: toStderr});
+
+    void run({
+        stdout: (line) => process.stdout.write(`${line}\n`),
+        stderr: (line) => process.stderr.write(`${line}\n`),
+    })
+        .catch((error) => {
+            process.stderr.write(`${errorPrefix}: ${error}\n`);
+            return 2;
+        })
+        .then((code) => {
+            // stdout в канал (pipe) на части систем пишется асинхронно: выходим, только когда строка ушла.
+            // Выход явный: после стопа EZSP могут остаться таймеры ASH (и брошенный по таймауту сеанс), ждать их незачем.
+            process.stdout.write("", () => process.exit(code));
+        });
+}
+/* v8 ignore stop */
