+// biome-ignore assist/source/organizeImports: import mocks first
+import {afterAll, beforeAll, beforeEach, describe, expect, it, vi} from "vitest";
+import * as data from "../mocks/data";
+import {mockMQTTPublishAsync, events as mqttEvents} from "../mocks/mqtt";
+import * as mockSleep from "../mocks/sleep";
+import {flushPromises} from "../mocks/utils";
+import {devices, events as zhEvents} from "../mocks/zigbeeHerdsman";
+import {Controller} from "../../lib/controller";
+import * as settings from "../../lib/util/settings";
+
+describe("BMS device report provenance", () => {
+    let controller: Controller;
+    const reports = () => mockMQTTPublishAsync.mock.calls.filter((c) => c[0] === "zigbee2mqtt/bridge/bms/device_report");
+    beforeAll(async () => {
+        vi.useFakeTimers();
+        data.writeDefaultConfiguration();
+        settings.reRead();
+        settings.set(["advanced", "bms_device_reports"], true);
+        controller = new Controller(vi.fn(), vi.fn());
+        mockSleep.mock();
+        await controller.start();
+        await flushPromises();
+    });
+    beforeEach(() => {
+        controller.state.clear();
+        mockMQTTPublishAsync.mockClear();
+    });
+    afterAll(async () => {
+        mockSleep.restore();
+        await controller.stop();
+        await flushPromises();
+        vi.useRealTimers();
+    });
+    it("reports only fields returned for the incoming frame, not cached state", async () => {
+        const device = devices.bulb_color;
+        const resolved = controller.zigbee.resolveEntity(device.ieeeAddr)!;
+        controller.state.set(resolved, {state: "ON", brightness: 200});
+        const receivedAt = Date.now();
+        await zhEvents.message({
+            device,
+            endpoint: device.getEndpoint(1),
+            cluster: "genLevelCtrl",
+            type: "attributeReport",
+            data: {currentLevel: 70},
+            linkquality: 20,
+            meta: {zclTransactionSequenceNumber: 9},
+        });
+        await flushPromises();
+        expect(reports()).toHaveLength(1);
+        const packet = JSON.parse(reports()[0][1]);
+        expect(packet).toMatchObject({
+            schema: 1,
+            source: "device",
+            received_at: receivedAt,
+            endpoint: 1,
+            raw: {currentLevel: 70},
+            payload: {brightness: 70},
+        });
+        expect(packet.payload.state).toBeUndefined();
+        expect(reports()[0][2]).toMatchObject({retain: false, qos: 0});
+    });
+    it("optimistic publication and a direct MQTT command do not become device reports", async () => {
+        await mqttEvents.message("zigbee2mqtt/bulb_color/set", '{"state":"ON"}');
+        await vi.advanceTimersByTimeAsync(250);
+        await flushPromises();
+        expect(reports()).toHaveLength(0);
+    });
+    it("emits original report before debounce and ignores derived delayed callbacks", async () => {
+        settings.set(["devices", devices.bulb_color.ieeeAddr, "debounce"], 1);
+        await zhEvents.message({
+            device: devices.bulb_color,
+            endpoint: devices.bulb_color.getEndpoint(1),
+            cluster: "genOnOff",
+            type: "attributeReport",
+            data: {onOff: 0},
+            linkquality: 20,
+        });
+        await flushPromises();
+        expect(reports()).toHaveLength(1);
+        expect(JSON.parse(reports()[0][1]).payload).toMatchObject({state: "OFF"});
+        await vi.advanceTimersByTimeAsync(1100);
+        expect(reports()).toHaveLength(1);
+    });
+});
