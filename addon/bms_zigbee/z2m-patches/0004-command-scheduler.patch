diff --git a/lib/util/bmsGroupMembership.ts b/lib/util/bmsGroupMembership.ts
new file mode 100644
--- /dev/null
+++ b/lib/util/bmsGroupMembership.ts
@@ -0,0 +1,57 @@
+// Один реестр для встроенной работы с группами и внешнего слоя Tuya.
+// Если слой ещё не запущен, база сама по себе не доказывает членство на устройстве.
+import type Group from "../model/group";
+import type Zigbee from "../zigbee";
+
+export interface GroupMembership {
+    withDeviceLock<T>(ieee: string, task: () => Promise<T>): Promise<T>;
+    invalidate(ieee: string, endpointID?: number): void;
+    verify(endpoint: zh.Endpoint): Promise<Set<number>>;
+    isVerified(group: Group): boolean;
+    getEpoch?(ieee: string): number;
+    isChanging?(ieee: string): boolean;
+}
+export function groupMembership(zigbee: Zigbee): GroupMembership | undefined {
+    return (zigbee as unknown as Record<symbol, GroupMembership>)[Symbol.for("bms.groupMembership")];
+}
+
+// Удаление группы затрагивает много IEEE. Версия закрывает также запрос, который
+// разобрал старую группу, а затем ждал lock устройства до окончания удаления.
+const mutations = new WeakMap<Zigbee, Map<number, {version: number; changing: boolean}>>();
+function mutation(zigbee: Zigbee, id: number): {version: number; changing: boolean} {
+    let groups = mutations.get(zigbee);
+    if (!groups) {
+        groups = new Map();
+        mutations.set(zigbee, groups);
+    }
+    let state = groups.get(id);
+    if (!state) {
+        state = {version: 0, changing: false};
+        groups.set(id, state);
+    }
+    return state;
+}
+export function groupMutationVersion(zigbee: Zigbee, id: number): number {
+    return mutation(zigbee, id).version;
+}
+export function assertGroupMutable(zigbee: Zigbee, id: number, version = groupMutationVersion(zigbee, id)): void {
+    const state = mutation(zigbee, id);
+    if (state.changing || state.version !== version) throw new Error("BMS: состав группы изменяется или изменился во время ожидания");
+}
+export function beginGroupMutation(zigbee: Zigbee, ids: number[]): () => void {
+    for (const id of ids) assertGroupMutable(zigbee, id);
+    const states = [...new Set(ids)].map((id) => mutation(zigbee, id));
+    for (const state of states) {
+        state.changing = true;
+        state.version += 1;
+    }
+    return () => {
+        for (const state of states) {
+            state.changing = false;
+            state.version += 1;
+        }
+    };
+}
+export function beginGroupRemoval(zigbee: Zigbee, id: number): () => void {
+    return beginGroupMutation(zigbee, [id]);
+}
