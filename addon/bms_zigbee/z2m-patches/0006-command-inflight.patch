diff --git a/lib/util/bmsOperationQueue.ts b/lib/util/bmsOperationQueue.ts
new file mode 100644
index 0000000..97a1f8f
--- /dev/null
+++ b/lib/util/bmsOperationQueue.ts
@@ -0,0 +1,35 @@
+// BMS: адаптерная очередь NWK не гарантирует порядок целых вызовов конвертера.
+// Держим конфликтующие IEEE до завершения Promise, включая вложенный Promise.all.
+export class BmsOperationQueue {
+    private tails = new Map<string, Promise<unknown>>();
+
+    run<T>(resources: string[], task: () => Promise<T>): Promise<T> {
+        const keys = [...new Set(resources)];
+        const previous = [
+            ...new Set(
+                keys.flatMap((key) => {
+                    const tail = this.tails.get(key);
+                    return tail ? [tail] : [];
+                }),
+            ),
+        ];
+        let resolve!: (value: T) => void;
+        let reject!: (error: unknown) => void;
+        const result = new Promise<T>((yes, no) => {
+            resolve = yes;
+            reject = no;
+        });
+        for (const key of keys) this.tails.set(key, result);
+        void (async () => {
+            if (previous.length) await Promise.allSettled(previous);
+            try {
+                resolve(await task());
+            } catch (error) {
+                reject(error);
+            } finally {
+                for (const key of keys) if (this.tails.get(key) === result) this.tails.delete(key);
+            }
+        })();
+        return result;
+    }
+}
