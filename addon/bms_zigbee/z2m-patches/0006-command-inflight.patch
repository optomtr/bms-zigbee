--- /dev/null
+++ b/test/bmsOperationQueue.test.ts
@@ -0,0 +1,59 @@
+import {describe, expect, it} from "vitest";
+import {BmsOperationQueue} from "../lib/util/bmsOperationQueue";
+
+describe("BMS in-flight operations", () => {
+    it("serializes one MCU across endpoints but leaves unrelated devices parallel", async () => {
+        const queue = new BmsOperationQueue();
+        const order: string[] = [];
+        let release!: () => void;
+        const a = queue.run(["ieee-a"], async () => {
+            order.push("a1");
+            await new Promise<void>((r) => {
+                release = r;
+            });
+        });
+        const b = queue.run(["ieee-a"], () => {
+            order.push("a2");
+            return Promise.resolve();
+        });
+        await queue.run(["ieee-b"], () => {
+            order.push("b");
+            return Promise.resolve();
+        });
+        expect(order).toEqual(["a1", "b"]);
+        release();
+        await Promise.all([a, b]);
+        expect(order).toEqual(["a1", "b", "a2"]);
+    });
+    it("holds intersecting groups until completion and releases all resources after failure", async () => {
+        const queue = new BmsOperationQueue();
+        const order: string[] = [];
+        let fail!: (error: Error) => void;
+        const first = queue.run(
+            ["g1", "a", "b", "a"],
+            () =>
+                new Promise<void>((_r, reject) => {
+                    fail = reject;
+                }),
+        );
+        const caught = first.catch(() => order.push("failed"));
+        const second = queue.run(["g2", "b", "c"], () => {
+            order.push("g2");
+            return Promise.resolve();
+        });
+        const third = queue.run(["c"], () => {
+            order.push("c");
+            return Promise.resolve();
+        });
+        expect(order).toEqual([]);
+        fail(new Error("busy"));
+        await Promise.all([caught, second, third]);
+        expect(order).toEqual(["failed", "g2", "c"]);
+        await queue.run(["a", "b", "c"], () => {
+            order.push("released");
+            return Promise.resolve();
+        });
+        await queue.run([], async () => {});
+        expect(order.at(-1)).toBe("released");
+    });
+});
