index 0000000..c8ee074
--- /dev/null
+++ b/test/extensions/bmsExtensionStatus.test.ts
@@ -0,0 +1,71 @@
+// biome-ignore assist/source/organizeImports: import mocks first
+import {afterEach, beforeEach, describe, expect, it, vi} from "vitest";
+import * as data from "../mocks/data";
+import "../mocks/zigbeeHerdsman";
+import "../mocks/logger";
+import {mockMQTTPublishAsync} from "../mocks/mqtt";
+import {flushPromises} from "../mocks/utils";
+import fs from "node:fs";
+import path from "node:path";
+import {Controller} from "../../lib/controller";
+import type ExternalExtensions from "../../lib/extension/externalExtensions";
+import * as settings from "../../lib/util/settings";
+
+const folder = path.join(data.mockDir, "external_extensions");
+const good = "export default class BmsTest { async start() {} async stop() {} }";
+const status = () => JSON.parse(mockMQTTPublishAsync.mock.calls.filter((c) => c[0] === "zigbee2mqtt/bridge/bms/extensions").at(-1)![1]);
+describe("BMS extension lifecycle truth", () => {
+    let controller: Controller;
+    beforeEach(() => {
+        vi.useFakeTimers();
+        data.writeDefaultConfiguration();
+        settings.reRead();
+        process.env.BMS_REQUIRED_EXTENSIONS = "bms-test.mjs";
+        fs.mkdirSync(folder, {recursive: true});
+        mockMQTTPublishAsync.mockClear();
+    });
+    afterEach(async () => {
+        await controller?.stop();
+        await flushPromises();
+        delete process.env.BMS_REQUIRED_EXTENSIONS;
+        fs.rmSync(folder, {recursive: true, force: true});
+        vi.useRealTimers();
+    });
+    const start = async (code?: string) => {
+        if (code) fs.writeFileSync(path.join(folder, "bms-test.mjs"), code);
+        controller = new Controller(vi.fn(), vi.fn());
+        await controller.start();
+        await flushPromises();
+    };
+    it("publishes started only after start resolved; removal and recovery change retained status", async () => {
+        await start(good);
+        expect(status()).toMatchObject({status: "ready", extensions: {"bms-test.mjs": {state: "started"}}});
+        const loader = controller.getExtension("ExternalExtensions") as ExternalExtensions;
+        await loader.onMQTTMessage({topic: "zigbee2mqtt/bridge/request/extension/remove", message: JSON.stringify({name: "bms-test.mjs"})});
+        expect(status()).toMatchObject({status: "degraded", extensions: {"bms-test.mjs": {state: "removed"}}});
+        await loader.onMQTTMessage({topic: "zigbee2mqtt/bridge/request/extension/save", message: JSON.stringify({name: "bms-test.mjs", code: good})});
+        expect(status().status).toBe("ready");
+    });
+    it("does not mistake a swallowed start exception for a loaded extension", async () => {
+        await start(good.replace("async start() {}", 'async start() { throw new Error("start failed"); }'));
+        expect(status()).toMatchObject({status: "degraded", extensions: {"bms-test.mjs": {state: "failed"}}});
+        expect(controller.getExtension("BmsTest")).toBeUndefined();
+        expect(fs.existsSync(path.join(folder, "bms-test.mjs.invalid"))).toBe(true);
+    });
+    it("detects missing and preexisting invalid required files", async () => {
+        process.env.BMS_REQUIRED_EXTENSIONS += ",bms-broken.mjs";
+        fs.writeFileSync(path.join(folder, "bms-broken.mjs.invalid"), "old failure");
+        await start();
+        expect(status()).toMatchObject({status: "degraded", extensions: {"bms-test.mjs": {state: "missing"}, "bms-broken.mjs": {state: "invalid"}}});
+    });
+    it("records an import error independently of start", async () => {
+        await start('import "./missing-bms-dependency.mjs"; export default class Broken {}');
+        expect(status().extensions["bms-test.mjs"]).toMatchObject({state: "failed"});
+        expect(status().extensions["bms-test.mjs"].error).toContain("missing-bms-dependency");
+    });
+    it("overwrites stale healthy status when external JS is disabled", async () => {
+        settings.set(["advanced", "enable_external_js"], false);
+        await start();
+        expect(status()).toMatchObject({status: "degraded", reason: "external_js_disabled"});
+    });
+});
