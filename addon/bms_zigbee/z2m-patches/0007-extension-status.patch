+import fs from "node:fs";
+import path from "node:path";
 import logger from "../util/logger";
 import * as settings from "../util/settings";
+import {stringify} from "../util/stringify";
 import type Extension from "./extension";
 import ExternalJSExtension from "./externalJS";
 
 type TModule = new (...args: ConstructorParameters<typeof Extension>) => Extension;
 
 export default class ExternalExtensions extends ExternalJSExtension<TModule> {
+    private bmsStates = new Map<string, {state: string; error?: string}>();
+
+    override async start(): Promise<void> {
+        this.bmsStates.clear();
+        const expected = (process.env.BMS_REQUIRED_EXTENSIONS ?? "").split(",").filter(Boolean);
+        for (const name of expected) {
+            if (!/^bms-[a-zA-Z0-9_-]+\.(mjs|cjs|js)$/.test(name)) throw new Error("BMS: invalid required extension filename");
+            const file = path.join(this.basePath, name);
+            this.bmsStates.set(name, {state: fs.existsSync(file) ? "loading" : fs.existsSync(`${file}.invalid`) ? "invalid" : "missing"});
+        }
+        await this.publishBmsStatus();
+        try {
+            await super.start();
+        } catch (error) {
+            for (const [name, value] of this.bmsStates) if (value.state === "loading") await this.reportLoad(name, "failed", error);
+            throw error;
+        }
+        await this.publishBmsStatus();
+    }
+
+    override async stop(): Promise<void> {
+        for (const [name, value] of this.bmsStates) if (value.state === "started") this.bmsStates.set(name, {state: "stopped"});
+        await this.publishBmsStatus();
+        await super.stop();
+    }
+
+    protected override async reportLoad(name: string, state: string, error?: unknown): Promise<void> {
+        if (!name.startsWith("bms-")) return;
+        this.bmsStates.set(name, {state, ...(error ? {error: String(error).slice(0, 500)} : {})});
+        await this.publishBmsStatus();
+    }
+
+    private async publishBmsStatus(): Promise<void> {
+        if (!this.bmsStates.size) return;
+        const extensions = Object.fromEntries(this.bmsStates);
+        const states = [...this.bmsStates.values()].map((v) => v.state);
+        const status = states.every((v) => v === "started")
+            ? "ready"
+            : states.some((v) => !["started", "loading"].includes(v))
+              ? "degraded"
+              : "loading";
+        try {
+            await this.mqtt.publish("bridge/bms/extensions", stringify({schema: 1, status, extensions}), {clientOptions: {retain: true, qos: 0}});
+        } catch (error) {
+            logger.warning(`BMS: extension status publish failed: ${error}`);
+        }
+        if (status === "degraded") logger.warning(`BMS: extensions degraded: ${stringify(extensions)}`);
+    }
+
     constructor(
         zigbee: Zigbee,
         mqtt: Mqtt,
