+// BMS: ограничитель групповых команд (lib/util/bmsGroupThrottle.ts).
+// biome-ignore assist/source/organizeImports: import mocks first
+import {afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi} from "vitest";
+import * as data from "../mocks/data";
+import {mockLogger} from "../mocks/logger";
+import {events as mockMQTTEvents, mockMQTTPublishAsync} from "../mocks/mqtt";
+import * as mockSleep from "../mocks/sleep";
+import {flushPromises} from "../mocks/utils";
+import {devices, groups, resetGroupMembers} from "../mocks/zigbeeHerdsman";
+
+import {clearGlobalStore} from "zigbee-herdsman-converters";
+import {Controller} from "../../lib/controller";
+import {loadTopicGetSetRegex} from "../../lib/extension/publish";
+import {mergeGroupMessage} from "../../lib/util/bmsGroupThrottle";
+import * as settings from "../../lib/util/settings";
+import {stringify} from "../../lib/util/stringify";
+
+describe("BMS: group command rate limit", () => {
+    let controller: Controller;
+    const bulbColor = devices.bulb_color.getEndpoint(1)!;
+    const bulbColor2 = devices.bulb_color_2.getEndpoint(1)!;
+    const bulb2 = devices.bulb_2.getEndpoint(1)!;
+    const bulb = devices.bulb.getEndpoint(1)!;
+    const allEndpoints = [bulbColor, bulbColor2, bulb2, bulb];
+
+    const set = async (name: string, payload: Record<string, unknown> | string): Promise<void> => {
+        await mockMQTTEvents.message(`zigbee2mqtt/${name}/set`, typeof payload === "string" ? payload : stringify(payload));
+        await flushPromises();
+    };
+    const wait = async (ms: number): Promise<void> => {
+        await vi.advanceTimersByTimeAsync(ms);
+        await flushPromises();
+    };
+    const commands = (group: keyof typeof groups): unknown[][] => groups[group].command.mock.calls.map((c) => [c[1], c[2]?.level]);
+    const published = (topic: string): Record<string, unknown>[] =>
+        mockMQTTPublishAsync.mock.calls.filter((c) => c[0] === `zigbee2mqtt/${topic}`).map((c) => JSON.parse(c[1]));
+    const throttleLog = (): string[] =>
+        mockLogger.info.mock.calls.map((c) => c[0]).filter((m): m is string => typeof m === "string" && m.startsWith("BMS: групповая к"));
+
+    beforeAll(async () => {
+        vi.useFakeTimers();
+        data.writeEmptyState();
+        controller = new Controller(vi.fn(), vi.fn());
+        mockSleep.mock();
+        await controller.start();
+        await flushPromises();
+    });
+
+    beforeEach(() => {
+        data.writeDefaultConfiguration();
+        controller.state.clear();
+        settings.reRead();
+        // Склейку проверяет bmsGroupCoalescing.test.ts; здесь она мешала бы (одиночные команды устройствам ждали бы окно).
+        settings.set(["advanced", "bms_group_coalescing"], false);
+        loadTopicGetSetRegex();
+        for (const group of Object.values(groups)) {
+            group.members = [];
+            group.command.mockClear();
+        }
+        groups.group_1.members.push(bulbColor, bulbColor2);
+        for (const ep of allEndpoints) ep.command.mockClear();
+        mockMQTTPublishAsync.mockClear();
+        mockLogger.info.mockClear();
+        clearGlobalStore();
+    });
+
+    afterEach(async () => {
+        // Дальше окна бюджета (9 с): следующий тест начинает с чистого учёта.
+        await wait(20000);
+        resetGroupMembers();
+    });
+
+    afterAll(async () => {
+        await vi.runOnlyPendingTimersAsync();
+        mockSleep.restore();
+        await controller?.stop();
+        await flushPromises();
+        vi.useRealTimers();
+    });
+
+    it("is on by default", () => {
+        const a = settings.get().advanced;
+        expect([a.bms_group_throttle, a.bms_group_throttle_window, a.bms_broadcast_budget, a.bms_broadcast_budget_window]).toStrictEqual([
+            true,
+            1000,
+            8,
+            9000,
+        ]);
+    });
+
+    it("sends the first and the last command of a slider series", async () => {
+        await set("group_1", {state: "ON", brightness: 254});
+        expect(commands("group_1")).toStrictEqual([["moveToLevelWithOnOff", 254]]);
+
+        for (const brightness of [200, 120, 59]) {
+            await wait(100);
+            await set("group_1", {state: "ON", brightness});
+        }
+        await wait(600);
+        // Окно группы (1000 мс) ещё не прошло: ничего нового в эфир, и состояние Z2M — по отправленному.
+        expect(commands("group_1")).toHaveLength(1);
+        expect(published("group_1").at(-1)).toMatchObject({brightness: 254});
+
+        await wait(100);
+        expect(commands("group_1")).toStrictEqual([
+            ["moveToLevelWithOnOff", 254],
+            ["moveToLevelWithOnOff", 59],
+        ]);
+        expect(published("group_1").at(-1)).toMatchObject({state: "ON", brightness: 59});
+        expect(published("bulb_color").at(-1)).toMatchObject({state: "ON", brightness: 59});
+        expect(throttleLog()).toStrictEqual(["BMS: групповая к 'group_1' отложена на 900 мс (окно группы 1000 мс)"]);
+    });
+
+    it("does not lose a state change merged with later fields", async () => {
+        await set("group_1", {state: "ON", brightness: 100});
+        await set("group_1", {state: "OFF"});
+        await set("group_1", {color_temp: 300});
+        await wait(1000);
+        // Порядок полей внутри команды — штатный Z2M (при OFF state уходит последним); главное — OFF не потерян.
+        expect(groups.group_1.command.mock.calls.map((c) => c[1])).toStrictEqual(["moveToLevelWithOnOff", "moveToColorTemp", "off"]);
+        expect(published("group_1").at(-1)).toMatchObject({state: "OFF", color_temp: 300});
+    });
+
+    it("lets the newest command win per field", () => {
+        expect(mergeGroupMessage({state: "ON", brightness: 100}, {brightness: 50})).toStrictEqual({state: "ON", brightness: 50});
+        expect(mergeGroupMessage({state: "ON", brightness: 100, color_temp: 300}, {state: "OFF"})).toStrictEqual({state: "OFF"});
