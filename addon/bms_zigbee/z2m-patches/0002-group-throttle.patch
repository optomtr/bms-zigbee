diff --git a/lib/util/bmsGroupThrottle.ts b/lib/util/bmsGroupThrottle.ts
new file mode 100644
index 0000000..70809a9
--- /dev/null
+++ b/lib/util/bmsGroupThrottle.ts
@@ -0,0 +1,250 @@
+// BMS: ограничитель групповых команд Zigbee.
+//
+// Почему: групповая команда в Zigbee — это широковещание. Его пересылает каждый повторитель сети (до 3 раз),
+// и каждый узел держит запись о нём в таблице широковещаний (BTT) около 9 с. В EmberZNet таблица по умолчанию
+// на 15 записей, и часть её занимают чужие широковещания (запросы маршрутов, объявления устройств). Когда
+// владелец водил ползунком яркости/цвета группы, Home Assistant слал команду несколько раз в секунду: на живой
+// сети (28 повторителей) это дало до 49 сообщений/с, NCP отвечал BUSY, шли ROUTE_ERROR, а одноадресные команды
+// реле висели по 10 с. В тишине те же реле отвечают за 0,1–0,3 с. Значит, ограничивать надо частоту широковещаний.
+//
+// Правило: на одну группу — не чаще одной команды за окно группы; на всю сеть — не больше N групповых за
+// скользящее окно (бюджет). Пока ограничение действует, новые команды группе не копятся очередью: они
+// сливаются в одну отложенную, побеждает последнее значение каждого поля, и по истечении ограничения уходит
+// одна команда. Состояния Z2M обновляются только тогда, когда команда действительно отправлена.
+import Group from "../model/group";
+import type Zigbee from "../zigbee";
+import logger from "./logger";
+import * as settings from "./settings";
+import {stringify} from "./stringify";
+
+export interface ThrottleTopic {
+    ID: string | number;
+    endpoint: string | undefined;
+    attribute: string;
+    type: "get" | "set";
+}
+
+type Send = (parsedTopic: ThrottleTopic, data: eventdata.MQTTMessage) => Promise<void>;
+type Parse = (parsedTopic: ThrottleTopic, data: eventdata.MQTTMessage) => KeyValue | undefined;
+
+interface Pending {
+    group: Group;
+    message: KeyValue;
+    merged: number;
+}
+
+// Поля, которые можно сливать «последнее побеждает». Остальное (toggle, сцены, эффекты, *_move/*_step,
+// get) по смыслу нельзя ни объединить, ни отбросить — такие команды уходят сразу, как в штатном Z2M.
+const MERGEABLE = new Set(["state", "brightness", "brightness_percent", "color_temp", "color_temp_percent", "color", "transition"]);
+const BRIGHTNESS = ["brightness", "brightness_percent"];
+const COLOR = ["color_temp", "color_temp_percent", "color"];
+const LOG_INTERVAL_MS = 1000;
+
+const isState = (value: unknown, state: string): boolean => typeof value === "string" && value.toLowerCase() === state;
+
+/** Слить новую команду в отложенную: последнее значение каждого поля побеждает, смена state не теряется. */
+export function mergeGroupMessage(pending: KeyValue, next: KeyValue): KeyValue {
+    const merged = {...pending};
+
+    // Выключение новее отложенных яркости и цвета: выключенной лампе они уже не нужны (конвертер Z2M при OFF
+    // яркость всё равно отбрасывает), а цвет после OFF ушёл бы лишним кадром.
+    if (isState(next.state, "off")) {
+        for (const key of [...BRIGHTNESS, ...COLOR]) delete merged[key];
+    }
+
+    // Яркость без state новее отложенного OFF: в Z2M яркость > 0 без state включает лампу — значит, OFF отменён.
+    const nextBrightness = next.brightness ?? next.brightness_percent;
+    if (next.state === undefined && nextBrightness !== undefined && Number(nextBrightness) > 0 && isState(merged.state, "off")) {
+        delete merged.state;
+    }
+
+    // Взаимоисключающие поля: прежнее значение в другой форме не должно спорить с новым.
+    for (const family of [BRIGHTNESS, COLOR]) {
+        if (family.some((key) => next[key] !== undefined)) {
+            for (const key of family) delete merged[key];
+        }
+    }
+
+    return Object.assign(merged, next);
+}
+
+export class GroupThrottle {
+    private zigbee: Zigbee;
+    private send: Send;
+    private parse: Parse;
+    private lastSent = new Map<number, number>();
+    // Отправленные групповые за последнее окно бюджета (время), по возрастанию.
+    private sentTimes: number[] = [];
+    // Отложенные по группам; порядок Map = порядок, в котором группы были отложены (кто раньше ждёт — раньше уйдёт).
+    private pending = new Map<number, Pending>();
+    private lastLog = new Map<number, number>();
+    private timer: NodeJS.Timeout | undefined;
+    private running = new Set<Promise<void>>();
+
+    constructor(zigbee: Zigbee, send: Send, parse: Parse) {
+        this.zigbee = zigbee;
+        this.send = send;
+        this.parse = parse;
+    }
+
+    /**
+     * true — команда группе взята ограничителем (отправлена сразу или отложена); false — обрабатывать как обычно
+     * (не группа, get, ограничитель выключен). Синхронно, как и склейка: порядок команд определяется здесь.
+     */
+    offer(parsedTopic: ThrottleTopic, data: eventdata.MQTTMessage): boolean {
+        if (!settings.get().advanced.bms_group_throttle || parsedTopic.type !== "set") {
+            return false;
+        }
+
+        const group = this.zigbee.resolveEntity(parsedTopic.ID);
+
+        if (!(group instanceof Group)) {
+            return false;
+        }
+
+        const message = this.parse(parsedTopic, data);
+
+        if (!message || typeof message !== "object" || Array.isArray(message)) {
+            // Не разбирается — пусть штатный код напишет свою ошибку.
+            return false;
+        }
+
+        const now = Date.now();
+        const mergeable =
+            parsedTopic.endpoint === undefined &&
+            Object.keys(message).every((k) => MERGEABLE.has(k)) &&
+            (message.state === undefined || isState(message.state, "on") || isState(message.state, "off"));
+
+        if (!mergeable) {
+            // Не сливается (toggle, сцена, эффект, *_move…). Отложенная команда этой группы уходит первой, чтобы
+            // порядок команд группе не перевернулся; обе — сразу (как в штатном Z2M), но в учёт бюджета.
+            this.sendPending(group.ID, now);
+            this.record(group.ID, now);
+            this.run(parsedTopic, data);
+            this.schedule();
+            return true;
+        }
+
+        const pending = this.pending.get(group.ID);
+
+        if (pending) {
+            pending.message = mergeGroupMessage(pending.message, message);
+            pending.merged += 1;
+            this.log(group, now, `объединена с отложенной (${pending.merged} шт.): ${stringify(pending.message)}`);
+            return true;
+        }
+
+        const wait = this.waitFor(group.ID, now);
+
+        if (wait <= 0) {
+            this.record(group.ID, now);
+            this.run(parsedTopic, data);
+            return true;
+        }
+
+        this.pending.set(group.ID, {group, message, merged: 1});
+        this.log(group, now, `отложена на ${wait} мс (${this.reason(group.ID, now)})`);
+        this.schedule();
+        return true;
+    }
+
+    /** При остановке отложенные команды уходят сразу, а не теряются. */
+    async stop(): Promise<void> {
+        clearTimeout(this.timer);
+        this.timer = undefined;
+
+        for (const ID of [...this.pending.keys()]) {
+            this.sendPending(ID, Date.now());
+        }
+
+        await Promise.allSettled([...this.running]);
+    }
+
+    private window(): {group: number; budget: number; budgetWindow: number} {
+        const a = settings.get().advanced;
+        return {group: a.bms_group_throttle_window, budget: a.bms_broadcast_budget, budgetWindow: a.bms_broadcast_budget_window};
+    }
+
+    private prune(now: number): void {
+        const {budgetWindow} = this.window();
+        while (this.sentTimes.length && this.sentTimes[0] <= now - budgetWindow) this.sentTimes.shift();
+    }
+
+    /** Через сколько мс группе можно отправить (0 — можно сейчас). */
+    private waitFor(Id: number, now: number): number {
+        const w = this.window();
+        this.prune(now);
+        const last = this.lastSent.get(Id);
+        const groupWait = last === undefined ? 0 : last + w.group - now;
+        // Бюджет занят: ждём, пока самая старая из учтённых выйдет из окна.
+        const budgetWait = this.sentTimes.length >= w.budget ? this.sentTimes[this.sentTimes.length - w.budget] + w.budgetWindow - now : 0;
+        return Math.max(0, groupWait, budgetWait);
+    }
+
+    private reason(Id: number, now: number): string {
+        const w = this.window();
+        const last = this.lastSent.get(Id);
+        return last !== undefined && last + w.group > now ? `окно группы ${w.group} мс` : `бюджет сети ${w.budget} групповых за ${w.budgetWindow} мс`;
+    }
+
+    private record(Id: number, now: number): void {
+        this.lastSent.set(Id, now);
+        this.sentTimes.push(now);
+    }
+
+    private sendPending(Id: number, now: number): void {
+        const pending = this.pending.get(Id);
+
+        if (!pending) {
+            return;
+        }
+
+        this.pending.delete(Id);
+        this.record(Id, now);
+
+        if (pending.merged > 1) {
+            logger.debug(`BMS: групповая к '${pending.group.name}': ${pending.merged} команд → одна ${stringify(pending.message)}`);
+        }
+
+        const topic: ThrottleTopic = {ID: Id, endpoint: undefined, attribute: "", type: "set"};
+        this.run(topic, {topic: `${settings.get().mqtt.base_topic}/${pending.group.name}/set`, message: stringify(pending.message)});
+    }
+
+    /** Один таймер на всё: отпускает отложенные по порядку, пока позволяют окно группы и бюджет сети. */
+    private schedule(): void {
+        clearTimeout(this.timer);
+        this.timer = undefined;
+        let next = Number.POSITIVE_INFINITY;
+        const now = Date.now();
+
+        for (const ID of [...this.pending.keys()]) {
+            const wait = this.waitFor(ID, now);
+
+            if (wait <= 0) {
+                this.sendPending(ID, now);
+            } else {
+                next = Math.min(next, wait);
+            }
+        }
+
+        if (next !== Number.POSITIVE_INFINITY) {
+            this.timer = setTimeout(() => this.schedule(), next);
+        }
+    }
+
+    private log(group: Group, now: number, text: string): void {
+        const last = this.lastLog.get(group.ID);
+
+        if (last === undefined || now - last >= LOG_INTERVAL_MS) {
+            this.lastLog.set(group.ID, now);
+            logger.info(`BMS: групповая к '${group.name}' ${text}`);
+        }
+    }
+
+    private run(parsedTopic: ThrottleTopic, data: eventdata.MQTTMessage): void {
+        const promise = this.send(parsedTopic, data)
+            .catch((error) => logger.error(`BMS: отправка '${data.topic}' не удалась: ${error}`))
+            .finally(() => this.running.delete(promise));
+        this.running.add(promise);
+    }
+}
