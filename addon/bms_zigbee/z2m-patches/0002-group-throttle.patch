+        await set("group_tradfri_remote", {state: "ON"});
+        await set("group_with_tradfri", {state: "ON"});
+        await wait(2000);
+        await set("group_with_tradfri", {state: "OFF"});
+        expect(groups.group_with_tradfri.command).toHaveBeenCalledTimes(0);
+
+        // Самая старая (group_1) выходит из окна бюджета через 9000 мс после отправки.
+        await wait(9000 - 2010 - 1);
+        expect(groups.group_with_tradfri.command).toHaveBeenCalledTimes(0);
+        await wait(1);
+        expect(groups.group_with_tradfri.command.mock.calls.map((c) => c[1])).toStrictEqual(["off"]);
+        expect(throttleLog()).toStrictEqual([
+            "BMS: групповая к 'group_with_tradfri' отложена на 8990 мс (бюджет сети 3 групповых за 9000 мс)",
+            'BMS: групповая к \'group_with_tradfri\' объединена с отложенной (2 шт.): {"state":"OFF"}',
+        ]);
+    });
+
+    it("never delays commands to single devices", async () => {
+        settings.set(["advanced", "bms_broadcast_budget"], 1);
+        await set("group_1", {state: "ON"});
+        await set("group_1", {state: "OFF"});
+        await set("bulb", {state: "OFF"});
+        expect(bulb.command).toHaveBeenCalledTimes(1);
+        expect(groups.group_1.command).toHaveBeenCalledTimes(1);
+    });
+
+    it("sends a pending command before a command it cannot merge (toggle)", async () => {
+        await set("group_1", {state: "ON"});
+        await set("group_1", {state: "ON", brightness: 100});
+        await set("group_1", {state: "TOGGLE"});
+        expect(groups.group_1.command.mock.calls.map((c) => c[1])).toStrictEqual(["on", "moveToLevelWithOnOff", "toggle"]);
+    });
+
+    it("limits coalesced group commands too", async () => {
+        settings.set(["advanced", "bms_group_coalescing"], true);
+        await set("bulb_color", {state: "OFF"});
+        await set("bulb_color_2", {state: "OFF"});
+        await wait(50);
+        expect(commands("group_1")).toStrictEqual([["off", undefined]]);
+        await set("bulb_color", {state: "ON"});
+        await set("bulb_color_2", {state: "ON"});
+        await wait(50);
+        // Склеенная вторая ушла бы через 100 мс после первой — ограничитель держит её до конца окна группы.
+        expect(commands("group_1")).toHaveLength(1);
+        await wait(949);
+        expect(commands("group_1")).toHaveLength(1);
+        await wait(1);
+        expect(commands("group_1")).toStrictEqual([
+            ["off", undefined],
+            ["on", undefined],
+        ]);
+    });
+
+    it("logs a deferred group at most once per second", async () => {
+        await set("group_1", {brightness: 11});
+        for (let i = 2; i < 30; i++) {
+            await wait(50);
+            await set("group_1", {brightness: 10 + i});
+        }
+        // 1,4 с: команды раз в секунду (0, 1000), в журнале — строка на каждую секунду, а не на каждую из 29 команд.
+        expect(commands("group_1")).toStrictEqual([
+            ["moveToLevelWithOnOff", 11],
+            ["moveToLevelWithOnOff", 30],
+        ]);
+        expect(throttleLog()).toHaveLength(2);
+    });
+
+    it("behaves like upstream when turned off", async () => {
+        settings.set(["advanced", "bms_group_throttle"], false);
+        for (const brightness of [10, 20, 30]) await set("group_1", {brightness});
+        expect(commands("group_1")).toStrictEqual([
+            ["moveToLevelWithOnOff", 10],
+            ["moveToLevelWithOnOff", 20],
+            ["moveToLevelWithOnOff", 30],
+        ]);
+        expect(throttleLog()).toStrictEqual([]);
+    });
+});
