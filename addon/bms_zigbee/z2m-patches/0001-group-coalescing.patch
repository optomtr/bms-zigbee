@@ -0,0 +1,284 @@
+// BMS: склейка одинаковых команд нескольким устройствам в групповую команду Zigbee.
+//
+// Почему: Home Assistant, выключая комнату, свою группу или сцену, шлёт КАЖДОЙ лампе отдельный
+// `<base>/<лампа>/set` почти одновременно. 18 одноадресных команд и сотни ответов на них забивают
+// эфир — часть команд теряется. Хаб Tuya в такой ситуации шлёт одну групповую команду. Здесь мы
+// делаем так же, но только по группам, которые уже есть в Z2M: если все участники группы получили
+// одинаковую команду в одном окне, вместо них уходит одна команда на группу.
+import type * as zhc from "zigbee-herdsman-converters";
+import Device from "../model/device";
+import type Group from "../model/group";
+import type Zigbee from "../zigbee";
+import logger from "./logger";
+import * as settings from "./settings";
+import {stringify} from "./stringify";
+
+export interface CoalesceTopic {
+    ID: string | number;
+    endpoint: string | undefined;
+    attribute: string;
+    type: "get" | "set";
+}
+
+interface Item {
+    device: Device;
+    parsedTopic: CoalesceTopic;
+    data: eventdata.MQTTMessage;
+    message: KeyValue;
+}
+
+type Send = (parsedTopic: CoalesceTopic, data: eventdata.MQTTMessage) => Promise<void>;
+
+// Что можно склеить и какой кластер ZCL для этого должен быть у лампы. Только простые значения:
+// toggle не склеиваем — групповой toggle Z2M считает по состоянию группы, а лампы переключаются
+// каждая от своего, и оптимистичные состояния участников разошлись бы с правдой.
+// Кластер проверяем, чтобы не отправить групповую команду устройству, которое управляется через
+// точки данных Tuya (TS0601 и т. п.): у них нет genOnOff, и групповой кадр они бы не поняли.
+const KEYS: Readonly<Record<string, {cluster?: string; valid: (v: unknown) => boolean}>> = {
+    state: {cluster: "genOnOff", valid: (v) => typeof v === "string" && ["on", "off"].includes(v.toLowerCase())},
+    brightness: {cluster: "genLevelCtrl", valid: (v) => typeof v === "number"},
+    color_temp: {cluster: "lightingColorCtrl", valid: (v) => typeof v === "number"},
+    transition: {valid: (v) => typeof v === "number"},
+};
+
+// Настройки устройства, которые меняют сам кадр Zigbee у световых конвертеров (transition, color_sync)
+// или то, как Z2M публикует состояние после команды (optimistic). Если у лампы они не такие, как у
+// группы, групповая команда (с настройками группы) была бы не той же командой — такую лампу не склеиваем.
+const OPTIONS_MUST_MATCH = ["transition", "color_sync", "optimistic"];
+
+// Окно ожидания отсчитывается от ПОСЛЕДНЕЙ команды пачки (каждая новая продлевает его), но не дольше
+// MAX_FACTOR окон от первой: на загруженном Home Assistant команды одной сцены приходят не разом,
+// а непрерывный поток команд не должен держать первую бесконечно.
+const MAX_FACTOR = 4;
+
+export class GroupCoalescer {
+    private zigbee: Zigbee;
+    private send: Send;
+    private parse: (parsedTopic: CoalesceTopic, data: eventdata.MQTTMessage) => KeyValue | undefined;
+    // Ключ — содержимое команды; в пачке — устройства с одинаковой командой, в порядке прихода.
+    private batches = new Map<string, Item[]>();
+    private pending = new Set<string>();
+    private timer: NodeJS.Timeout | undefined;
+    private firstAt = 0;
+    private running = new Set<Promise<void>>();
+
+    constructor(zigbee: Zigbee, send: Send, parse: (parsedTopic: CoalesceTopic, data: eventdata.MQTTMessage) => KeyValue | undefined) {
+        this.zigbee = zigbee;
+        this.send = send;
+        this.parse = parse;
+    }
+
+    /**
+     * true — команда взята в пачку и уйдёт по окончании окна; false — обрабатывать как обычно.
+     * Решение синхронное: Z2M обрабатывает MQTT-сообщения параллельно, и порядок отправки команд
+     * одному устройству определяется тем, кто первым дошёл до отправки. Поэтому здесь нет await.
+     */
+    offer(parsedTopic: CoalesceTopic, data: eventdata.MQTTMessage): boolean {
+        const item = settings.get().advanced.bms_group_coalescing ? this.toItem(parsedTopic, data) : undefined;
+
+        if (!item) {
+            // Команда не склеивается, но относится к устройству, чья команда ещё ждёт в пачке:
+            // отправляем пачку сейчас, чтобы команды этому устройству ушли в том порядке, в каком пришли.
+            if (this.pending.size && this.touchesPending(parsedTopic)) {
+                this.flush();
+            }
+
+            return false;
+        }
+
+        // Вторая команда тому же устройству в одном окне — сначала отправить первую.
+        if (this.pending.has(item.device.ID)) {
+            this.flush();
+        }
+
+        const key = stringify(Object.entries(item.message).sort(([a], [b]) => (a < b ? -1 : 1)));
+        const batch = this.batches.get(key);
+
+        if (batch) {
+            batch.push(item);
+        } else {
+            this.batches.set(key, [item]);
+        }
+
+        this.pending.add(item.device.ID);
+        const now = Date.now();
+
+        if (this.timer === undefined) {
+            this.firstAt = now;
+        } else {
+            clearTimeout(this.timer);
+        }
+
+        const window = settings.get().advanced.bms_group_coalescing_window;
+        this.timer = setTimeout(() => this.flush(), Math.max(0, Math.min(window, this.firstAt + window * MAX_FACTOR - now)));
+
+        return true;
+    }
+
+    /** Отправить всё, что ждёт, сразу. Отправка запускается синхронно (см. offer). */
+    flush(): void {
+        clearTimeout(this.timer);
+        this.timer = undefined;
+        const batches = [...this.batches.values()];
+        this.batches.clear();
+        this.pending.clear();
+
+        for (const batch of batches) {
+            const {groups, rest} = this.plan(batch);
+
+            if (groups.length) {
+                const names = groups.map(([g]) => g.name).join(", ");
+                logger.info(`BMS: склеено ${batch.length} команд → группы [${names}] + ${rest.length} по отдельности`);
+            } else if (batch.length > 1) {
+                logger.debug(`BMS: ${batch.length} одинаковых команд — подходящей группы нет, по отдельности`);
+            }
+
+            for (const [group, message] of groups) {
+                // Отправка ровно тем же путём, что и сообщение `<base>/<группа>/set`: тот же конвертер,
+                // те же оптимистичные состояния группы и её участников (их публикует расширение groups).
+                const groupTopic: CoalesceTopic = {ID: group.ID, endpoint: undefined, attribute: "", type: "set"};
+                this.run(groupTopic, {topic: `${settings.get().mqtt.base_topic}/${group.name}/set`, message: stringify(message)});
+            }
+
+            for (const item of rest) {
+                this.run(item.parsedTopic, item.data);
+            }
+        }
+    }
+
+    /** При остановке Z2M ждущие команды отправляются, а не теряются. */
+    async stop(): Promise<void> {
+        this.flush();
+        await Promise.allSettled([...this.running]);
+    }
+
+    private run(parsedTopic: CoalesceTopic, data: eventdata.MQTTMessage): void {
+        const promise = this.send(parsedTopic, data)
+            .catch((error) => logger.error(`BMS: отправка '${data.topic}' не удалась: ${error}`))
+            .finally(() => this.running.delete(promise));
+        this.running.add(promise);
+    }
+
+    private toItem(parsedTopic: CoalesceTopic, data: eventdata.MQTTMessage): Item | undefined {
+        if (parsedTopic.type !== "set" || parsedTopic.endpoint !== undefined) {
+            return undefined;
+        }
+
+        const device = this.zigbee.resolveEntity(parsedTopic.ID);
+
+        if (!(device instanceof Device) || !device.definition) {
+            return undefined;
+        }
+
+        const message = this.parse(parsedTopic, data);
+
+        if (!message || typeof message !== "object" || Array.isArray(message)) {
+            return undefined;
+        }
+
+        const keys = Object.keys(message);
+        const endpoint = device.endpoint();
+
+        if (!keys.length || !endpoint || keys.some((k) => !Object.hasOwn(KEYS, k) || !KEYS[k].valid(message[k]))) {
+            return undefined;
+        }
+
+        // Устройство не входит ни в одну группу, которую вообще можно было бы использовать, — держать
+        // его команду незачем: она уйдёт сразу, как в штатном Z2M.
+        const inGroup = this.zigbee
+            .groupsIterator((g) => g.members.length >= 2 && g.members.some((m) => m.deviceIeeeAddress === device.ieeeAddr && m.ID === endpoint.ID))
+            .next();
+
+        if (inGroup.done) {
+            return undefined;
+        }
+
+        return {device, parsedTopic, data, message};
+    }
+
+    private touchesPending(parsedTopic: CoalesceTopic): boolean {
+        const entity = this.zigbee.resolveEntity(parsedTopic.ID);
+
+        if (entity instanceof Device) {
+            return this.pending.has(entity.ID);
+        }
+
+        return !!entity && entity.zh.members.some((m) => this.pending.has(m.deviceIeeeAddress));
+    }
+
+    /**
+     * Какие группы покрывают пачку: все участники группы получили эту команду (по своей основной
+     * точке, без повторов), группа не меньше 2 участников, конвертеры у группы и у каждого участника
+     * те же. Жадно: сначала самые большие, без пересечений. Остальное — по отдельности.
+     */
+    private plan(batch: Item[]): {groups: [Group, KeyValue][]; rest: Item[]} {
+        const rest = new Map(batch.map((i) => [i.device.ID, i]));
+
+        if (batch.length < 2) {
+            return {groups: [], rest: batch};
+        }
+
+        const keys = Object.keys(batch[0].message);
+        const candidates: Group[] = [];
+
+        for (const group of this.zigbee.groupsIterator((g) => g.members.length >= 2 && g.members.length <= batch.length)) {
+            if (this.covers(group, rest, keys)) {
+                candidates.push(group);
+            }
+        }
+
+        candidates.sort((a, b) => b.zh.members.length - a.zh.members.length || a.ID - b.ID);
+        const groups: [Group, KeyValue][] = [];
+
+        for (const group of candidates) {
+            const members = group.zh.members.map((m) => m.deviceIeeeAddress);
+
+            if (members.every((ieee) => rest.has(ieee))) {
+                // biome-ignore lint/style/noNonNullAssertion: проверено строкой выше
+                groups.push([group, rest.get(members[0])!.message]);
+
+                for (const ieee of members) {
+                    rest.delete(ieee);
+                }
+            }
+        }
+
+        return {groups, rest: [...rest.values()]};
+    }
+
+    private covers(group: Group, items: Map<string, Item>, keys: string[]): boolean {
+        const seen = new Set<string>();
+        const groupConverters = Array.from(new Set(group.membersDefinitions().flatMap((d) => d.toZigbee)));
+        const find = (converters: ReadonlyArray<zhc.Tz.Converter>, key: string, device: boolean): zhc.Tz.Converter | undefined =>
+            converters.find((c) => (!c.key || c.key.includes(key)) && (!device || !c.endpoints));
+
+        for (const member of group.zh.members) {
+            const item = items.get(member.deviceIeeeAddress);
+
+            if (!item || seen.has(member.deviceIeeeAddress) || item.device.endpoint()?.ID !== member.ID) {
+                return false;
+            }
+
+            seen.add(member.deviceIeeeAddress);
+            const clusters = member.getInputClusters().map((c) => c.name);
+            const deviceOptions = item.device.options as KeyValue;
+            const groupOptions = group.options as KeyValue;
+
+            for (const key of keys) {
+                const cluster = KEYS[key].cluster;
+                // biome-ignore lint/style/noNonNullAssertion: в пачку попадают только устройства с definition
+                const converter = find(item.device.definition!.toZigbee, key, true);
+
+                if ((cluster && !clusters.includes(cluster)) || !converter?.convertSet || converter !== find(groupConverters, key, false)) {
+                    return false;
+                }
+            }
+
+            if (OPTIONS_MUST_MATCH.some((o) => deviceOptions[o] !== groupOptions[o])) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+}
